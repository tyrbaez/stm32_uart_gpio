mach create "stm32f407"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl
machine LoadPlatformDescription @C:\roverproje\uart_gpio.repl
emulation CreateServerSocketTerminal 3456 "uartTerm" false
connector Connect sysbus.usart2 uartTerm
sysbus LoadELF @C:\roverproje\rover.elf
start